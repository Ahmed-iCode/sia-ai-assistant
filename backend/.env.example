# Project settings
PROJECT_NAME="AI Task Assistant API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security / JWT
SECRET_KEY="ai_task_assistant_super_secret_jwt_key_at_least_32_chars_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite:///./task_assistant.db"

# CORS
BACKEND_CORS_ORIGINS='["http://localhost", "http://localhost:3000", "http://localhost:5000", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:5000", "http://127.0.0.1:8000", "*"]'
CORS_ORIGINS="https://sia-app.pages.dev,https://sia.yourdomain.com"

# Background Reminder Scheduler
SCHEDULER_INTERVAL_SECONDS=60
DEFAULT_TIMEZONE="Africa/Cairo"

# AI Voice & Agent Orchestration (Phase 3)
GEMINI_API_KEY=""
GROQ_API_KEY=""
GEMINI_MODEL="gemini-3.0-flash"
WHISPER_MODEL="whisper-large-v3-turbo"
